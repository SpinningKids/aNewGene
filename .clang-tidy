---
# Deliberately conservative: high-confidence bugs on a legacy codebase,
# kept stable across clang-tidy versions (CI image 18/22+).
Checks: >
  bugprone-*,
  clang-analyzer-core.*,
  clang-analyzer-cplusplus.NewDelete,
  clang-analyzer-cplusplus.SmartPtr,
  clang-analyzer-deadcode.DeadStores,
  clang-analyzer-optin.cplusplus.UninitializedObject,
  clang-analyzer-security.FloatLoopCounter,
  clang-analyzer-unix.Malloc,
  clang-analyzer-unix.MismatchedDeallocator,
  clang-analyzer-llvm.Constructors,
  clang-analyzer-llvm.ContainerEnd,
  clang-analyzer-llvm.PureVirtualCalls,
  clang-analyzer-llvm.ReturnType,
  clang-analyzer-llvm.VarUse,
  misc-*,
  readability-deleted-function,
  readability-dynamic-type-size,
  readability-inconsistent-declaration-parameter-name,
  readability-make-function-static,
  readability-uniqueptr-for-smartptr,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-misleading-indentation,
  -bugprone-narrowing-conversions,
  -bugprone-reserved-identifier,
  -bugprone-undefined-memory-manipulation,
  -bugprone-switch-missing-default-case,
  -misc-const-correctness,
  -misc-include-cleaner,
  -misc-no-recursion,
  -misc-non-private-member-variables-in-classes,
  -misc-strings-cstring,
  -misc-unconventional-assign-operator,
  -misc-unused-parameters,
  -misc-use-anonymous-namespace,
  -misc-use-internal-linkage,
  -readability-magic-numbers,

# High-confidence families are a hard gate; style families are advisory.
WarningsAsErrors: bugprone-*,clang-analyzer-*
HeaderFilterRegex: 'src/.*'
